# Lets .github/workflows/staging.yml open SSH on the staging box's security
# group to the current runner's IP, and nothing else. Add to the Terraform that
# owns the box (server-infra's terraform/), then set the role ARN as the
# STAGING_AWS_ROLE_ARN variable on the GitHub "staging" environment.
#
# Only adds IAM resources: it does not touch the instance or user_data.

variable "staging_security_group_id" {
  description = "Security group on the staging box (yt-dlp-sg)"
  type        = string
}

data "aws_caller_identity" "current" {}
data "aws_region" "current" {}

# One per AWS account. If the account already has it, import it instead.
resource "aws_iam_openid_connect_provider" "github" {
  url            = "https://token.actions.githubusercontent.com"
  client_id_list = ["sts.amazonaws.com"]
}

resource "aws_iam_role" "uwflow_staging_deploy" {
  name = "uwflow-staging-deploy"
  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect    = "Allow"
      Action    = "sts:AssumeRoleWithWebIdentity"
      Principal = { Federated = aws_iam_openid_connect_provider.github.arn }
      Condition = {
        StringEquals = {
          "token.actions.githubusercontent.com:aud" = "sts.amazonaws.com"
          # Only jobs bound to the "staging" environment of this repository.
          "token.actions.githubusercontent.com:sub" = "repo:UWFlow/uwflow:environment:staging"
        }
      }
    }]
  })
}

resource "aws_iam_role_policy" "uwflow_staging_deploy" {
  role = aws_iam_role.uwflow_staging_deploy.id
  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Effect = "Allow"
        Action = ["ec2:AuthorizeSecurityGroupIngress", "ec2:RevokeSecurityGroupIngress"]
        Resource = "arn:aws:ec2:${data.aws_region.current.region}:${data.aws_caller_identity.current.account_id}:security-group/${var.staging_security_group_id}"
      },
      {
        # Describe calls cannot be scoped to a resource.
        Effect   = "Allow"
        Action   = "ec2:DescribeSecurityGroups"
        Resource = "*"
      },
    ]
  })
}

output "uwflow_staging_deploy_role_arn" {
  value = aws_iam_role.uwflow_staging_deploy.arn
}
