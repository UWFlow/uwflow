#!/usr/bin/env bash
#
# Staging deploy entrypoint. Installed root-owned as /usr/local/sbin/uwflow-staging
# and reached by GitHub Actions through a forced SSH command:
#
#   restrict,command="sudo -n /usr/local/sbin/uwflow-staging \"$SSH_ORIGINAL_COMMAND\"" ssh-ed25519 ...
#
# The caller picks a verb; it never picks a script. Everything that runs here
# comes from the main-branch checkout install.sh copied, so a PR can only
# supply data: images it built and the hasura/ + nginx/ trees it ships.
#
# Verbs:
#   login USER                 docker login to the staging registry; token on stdin
#   logout                     forget registry credentials
#   deploy SHA NAME [refresh]  stdin: tar.gz of hasura/ and nginx/ at SHA
#   smoke                      post-deploy checks against the running release
#   sync-data                  restore the newest production dump into staging
#   status                     what is deployed and whether it is running
#   logs [SERVICE]             recent container logs, for failed runs
set -euo pipefail

CONF_DIR=/etc/uwflow-staging
SHARE_DIR=/usr/local/share/uwflow-staging
STATE_DIR=/var/lib/uwflow-staging
SERVICES=(postgres hasura api frontend)
KEEP_RELEASES=3

log() { printf '[staging] %s\n' "$*" >&2; }
die() { printf '[staging] error: %s\n' "$*" >&2; exit 1; }

[ "$(id -u)" -eq 0 ] || die "must run as root (sudo -n $0)"
[ -f "$CONF_DIR/staging.conf" ] || die "missing $CONF_DIR/staging.conf; run install.sh"
# shellcheck source=/dev/null
. "$CONF_DIR/staging.conf"
: "${STAGING_REGISTRY:?set in staging.conf}"
: "${PROD_HOST:?set in staging.conf}"
: "${PROD_BACKUP_DIR:?set in staging.conf}"
# Loopback ports staging publishes; docker-compose.staging.yml reads these too.
export STAGING_REGISTRY
export STAGING_POSTGRES_PORT="${STAGING_POSTGRES_PORT:-15432}"
export STAGING_HASURA_PORT="${STAGING_HASURA_PORT:-18080}"
export STAGING_HTTPS_PORT="${STAGING_HTTPS_PORT:-18443}"

# Read one key from the app env file without sourcing it into this shell.
env_get() {
  sed -n "s/^[[:space:]]*$1=//p" "$CONF_DIR/env" | tail -n1 \
    | sed -e 's/[[:space:]]*$//' -e 's/^"\(.*\)"$/\1/' -e "s/^'\(.*\)'\$/\1/"
}
PG_USER="$(env_get POSTGRES_USER)"
PG_PORT="$(env_get POSTGRES_PORT)"
PG_DB="$(env_get POSTGRES_DB)"
DOMAIN="$(env_get DOMAIN)"

compose() {
  local release="$1"; shift
  UWFLOW_IMAGE_TAG="$(basename "$(realpath "$release")")" \
    docker compose -p uwflow-staging \
      --project-directory "$release" \
      --env-file "$CONF_DIR/env" \
      -f "$SHARE_DIR/docker-compose.yml" \
      -f "$SHARE_DIR/docker-compose.staging.yml" \
      "$@"
}

# psql_in DATABASE [psql args...]
psql_in() {
  local db="$1"; shift
  docker exec -i postgres psql -X -q -v ON_ERROR_STOP=1 -U "$PG_USER" -p "$PG_PORT" -d "$db" "$@"
}
psql_admin() { psql_in postgres "$@"; }

wait_for() {
  local what="$1" seconds="$2"; shift 2
  local deadline=$((SECONDS + seconds))
  until "$@" >/dev/null 2>&1; do
    [ "$SECONDS" -lt "$deadline" ] || die "timed out after ${seconds}s waiting for $what"
    sleep 2
  done
  log "$what is up"
}

pg_ready() { docker exec postgres pg_isready -q -U "$PG_USER" -p "$PG_PORT"; }

has_schema() {
  [ "$(psql_in "$PG_DB" -tAc "select to_regclass('public.course') is not null" 2>/dev/null)" = t ]
}

# Print why the database must be replaced before RELEASE can run, or nothing.
refresh_reason() {
  local release="$1" requested="$2" previous=""
  if [ "$requested" = refresh ]; then echo "requested by the workflow"; return; fi
  if ! has_schema; then echo "staging has no UWFlow data yet"; return; fi
  [ -L "$STATE_DIR/current" ] && previous="$(realpath "$STATE_DIR/current")"
  [ -n "$previous" ] && [ -d "$previous/hasura/migrations/default" ] || return 0
  # Hasura only migrates forward. If the last deploy applied a migration this
  # revision lacks (another PR's schema change), the data no longer matches.
  local m
  for m in "$previous"/hasura/migrations/default/*/; do
    m="$(basename "$m")"
    if [ ! -d "$release/hasura/migrations/default/$m" ]; then
      echo "previous deploy applied migration $m, which this revision does not have"
      return
    fi
  done
}

ssh_prod() { ssh -F "$CONF_DIR/prod_ssh_config" -o BatchMode=yes "$@"; }
scp_prod() { scp -F "$CONF_DIR/prod_ssh_config" -o BatchMode=yes -q "$@"; }

# Replace the staging database with the newest production dump.
# Restores into a scratch database first, so a bad dump never touches staging.
sync_data() {
  local release="$1"
  [ -f "$CONF_DIR/prod_ssh_config" ] || die "missing $CONF_DIR/prod_ssh_config (see README)"

  local latest
  latest="$(ssh_prod "$PROD_HOST" "ls -1 -- $(printf %q "$PROD_BACKUP_DIR")" \
    | grep -E '^[0-9]{4}-[0-9]{2}-[0-9]{2}-pg-latest\.dump$' | sort | tail -n1 || true)"
  [ -n "$latest" ] || die "no *-pg-latest.dump found in $PROD_HOST:$PROD_BACKUP_DIR"

  local dump="$STATE_DIR/dumps/$latest"
  if [ ! -s "$dump" ]; then
    log "copying $PROD_HOST:$PROD_BACKUP_DIR/$latest"
    rm -f "$STATE_DIR"/dumps/*.part
    scp_prod "$PROD_HOST:$PROD_BACKUP_DIR/$latest" "$dump.part"
    mv "$dump.part" "$dump"
  else
    log "reusing already-copied $latest"
  fi
  # Keep only the dump we are about to restore.
  find "$STATE_DIR/dumps" -maxdepth 1 -type f ! -name "$latest" -delete

  docker cp "$dump" postgres:/tmp/staging-restore.dump
  # Fails fast on a truncated or non-custom-format archive.
  docker exec postgres pg_restore --list /tmp/staging-restore.dump >/dev/null \
    || die "$latest is not a readable pg_dump archive"

  log "restoring $latest into scratch database"
  psql_admin -c 'DROP DATABASE IF EXISTS flow_incoming' -c 'CREATE DATABASE flow_incoming'
  docker exec postgres pg_restore -U "$PG_USER" -p "$PG_PORT" -d flow_incoming \
    --no-owner --no-acl --exit-on-error --jobs 2 /tmp/staging-restore.dump \
    || { docker exec postgres rm -f /tmp/staging-restore.dump; die "pg_restore failed; staging data unchanged"; }
  docker exec postgres rm -f /tmp/staging-restore.dump

  log "swapping restored data into $PG_DB"
  compose "$release" stop hasura api >/dev/null 2>&1 || true
  psql_admin <<SQL
\o /dev/null
SELECT pg_terminate_backend(pid) FROM pg_stat_activity
 WHERE datname IN ('$PG_DB', 'flow_incoming') AND pid <> pg_backend_pid();
DROP DATABASE IF EXISTS flow_previous;
SELECT 'ALTER DATABASE "$PG_DB" RENAME TO flow_previous'
 WHERE EXISTS (SELECT FROM pg_database WHERE datname = '$PG_DB') \gexec
ALTER DATABASE flow_incoming RENAME TO "$PG_DB";
SQL
  printf 'DATA_DUMP=%s\nDATA_RESTORED_AT=%s\n' "$latest" "$(date -u +%FT%TZ)" > "$STATE_DIR/data"
  log "staging data now matches production dump $latest"
}

valid_sha()  { [[ "$1" =~ ^[0-9a-f]{40}$ ]]; }
valid_name() { [[ "$1" =~ ^[a-z0-9][a-z0-9-]{0,39}$ ]]; }

cmd_deploy() {
  local sha="${1:-}" name="${2:-}" refresh="${3:-}"
  valid_sha "$sha" || die "deploy: expected a full 40-character commit SHA"
  valid_name "$name" || die "deploy: expected a name like pr-123 or main"
  [ -z "$refresh" ] || [ "$refresh" = refresh ] || die "deploy: third argument must be 'refresh'"

  local release="$STATE_DIR/releases/$sha" incoming
  incoming="$(mktemp -d "$STATE_DIR/releases/.incoming.XXXXXX")"
  trap 'rm -rf "$incoming"' EXIT
  # Only these two trees are taken from the PR, and only as data.
  tar -xzf - -C "$incoming" --no-same-owner --no-same-permissions hasura nginx \
    || die "deploy: stdin must be a tar.gz containing hasura/ and nginx/"
  [ -d "$incoming/hasura/migrations" ] && [ -d "$incoming/hasura/metadata" ] \
    && [ -f "$incoming/nginx/run.sh" ] || die "deploy: archive is missing hasura/ or nginx/ files"
  [ -z "$(find "$incoming" -type l -print -quit)" ] || die "deploy: archive must not contain symlinks"
  chmod -R u=rwX,go=rX "$incoming"
  ln -s "$CONF_DIR/env" "$incoming/.env"
  ln -s "$CONF_DIR/ssl" "$incoming/.ssl"
  rm -rf "$release"
  mv "$incoming" "$release"
  trap - EXIT

  log "deploying $name at $sha"
  # Pull everything before stopping anything, so a missing image is harmless.
  compose "$release" pull --quiet "${SERVICES[@]}"
  compose "$release" up -d postgres
  wait_for postgres 90 pg_ready

  local reason
  reason="$(refresh_reason "$release" "$refresh")"
  if [ -n "$reason" ]; then
    log "refreshing data: $reason"
    sync_data "$release"
  fi

  ln -sfn "$release" "$STATE_DIR/.current.new"
  mv -T "$STATE_DIR/.current.new" "$STATE_DIR/current"
  # Hasura's cli-migrations image applies this revision's migrations and
  # metadata on start, so schema changes in the PR land here.
  compose "$release" up -d --remove-orphans "${SERVICES[@]}"
  wait_for hasura 180 curl -fsS "http://127.0.0.1:$STAGING_HASURA_PORT/healthz"
  wait_for frontend 60 curl -fsSk -o /dev/null -H "Host: $DOMAIN" "https://127.0.0.1:$STAGING_HTTPS_PORT/"

  psql_admin -c 'DROP DATABASE IF EXISTS flow_previous' >/dev/null
  printf 'NAME=%s\nSHA=%s\nDEPLOYED_AT=%s\n' "$name" "$sha" "$(date -u +%FT%TZ)" > "$STATE_DIR/deployed"
  prune "$sha"
  log "deployed $name at $sha"
}

# Keep the newest few releases and their images; staging has a small disk.
prune() {
  local keep="$1" dir tag
  local -a old
  # Release directories are named by validated 40-hex SHAs only.
  # shellcheck disable=SC2010
  mapfile -t old < <(ls -1t "$STATE_DIR/releases" | grep -E '^[0-9a-f]{40}$' | tail -n +$((KEEP_RELEASES + 1)))
  for dir in "${old[@]}"; do
    [ "$dir" = "$keep" ] && continue
    rm -rf "${STATE_DIR:?}/releases/$dir"
  done
  # Drop images whose release directory is gone.
  docker images --format '{{.Repository}}:{{.Tag}}' --filter "reference=$STAGING_REGISTRY/uwflow-staging-*" | while read -r image; do
    tag="${image##*:}"
    [ -d "$STATE_DIR/releases/$tag" ] || docker rmi "$image" >/dev/null 2>&1 || true
  done
  docker image prune -f >/dev/null
}

cmd_login() {
  local user="${1:-}"
  [[ "$user" =~ ^[A-Za-z0-9][A-Za-z0-9-]{0,38}(\[bot\])?$ ]] || die "login: expected a GitHub user name"
  docker login "${STAGING_REGISTRY%%/*}" -u "$user" --password-stdin >/dev/null
  log "logged in to ${STAGING_REGISTRY%%/*}"
}

cmd_logout() { docker logout "${STAGING_REGISTRY%%/*}" >/dev/null 2>&1 || true; }

current_release() {
  [ -L "$STATE_DIR/current" ] || die "nothing has been deployed yet"
  realpath "$STATE_DIR/current"
}

cmd_smoke() {
  local release
  release="$(current_release)"
  STAGING_SHA="$(basename "$release")" \
  STAGING_DOMAIN="$DOMAIN" \
  HASURA_ADMIN_SECRET="$(env_get HASURA_GRAPHQL_ADMIN_SECRET)" \
    python3 -I /usr/local/sbin/uwflow-staging-smoke
}

cmd_sync_data() {
  local release
  release="$(current_release)"
  sync_data "$release"
  compose "$release" up -d "${SERVICES[@]}"
  wait_for hasura 180 curl -fsS "http://127.0.0.1:$STAGING_HASURA_PORT/healthz"
  psql_admin -c 'DROP DATABASE IF EXISTS flow_previous' >/dev/null
}

cmd_status() {
  cat "$STATE_DIR/deployed" 2>/dev/null || echo "NAME=(none)"
  cat "$STATE_DIR/data" 2>/dev/null || echo "DATA_DUMP=(none)"
  if [ -L "$STATE_DIR/current" ]; then compose "$(current_release)" ps; fi
}

cmd_logs() {
  local service="${1:-}"
  if [ -n "$service" ]; then
    [[ " ${SERVICES[*]} " == *" $service "* ]] || die "logs: unknown service $service"
  fi
  compose "$(current_release)" logs --no-color --tail 200 ${service:+"$service"}
}

main() {
  # Forced commands deliver the client's request as one string; split it
  # into words ourselves (no globbing, no expansion).
  local -a argv
  if [ $# -eq 1 ]; then read -r -a argv <<<"$1"; else argv=("$@"); fi
  [ ${#argv[@]} -gt 0 ] || die "usage: $(basename "$0") login|logout|deploy|smoke|sync-data|status|logs"
  local verb="${argv[0]}"
  argv=("${argv[@]:1}")

  install -d -m 0750 "$STATE_DIR" "$STATE_DIR/releases" "$STATE_DIR/dumps"
  # One operation at a time: there is one database and one set of containers.
  exec 9>"$STATE_DIR/lock"
  flock -w 900 9 || die "another staging operation is still running"

  case "$verb" in
    login)     cmd_login "${argv[@]}" ;;
    logout)    cmd_logout ;;
    deploy)    cmd_deploy "${argv[@]}" ;;
    smoke)     cmd_smoke ;;
    sync-data) cmd_sync_data ;;
    status)    cmd_status ;;
    logs)      cmd_logs "${argv[@]}" ;;
    *)         die "unknown verb: $verb" ;;
  esac
}

main "$@"
