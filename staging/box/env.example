# /etc/uwflow-staging/env — the staging stack's .env (root-owned, 0600).
#
# install.sh fills in the CHANGE_ME secrets with fresh random values. Never
# reuse production's: the JWT key in particular must differ, so production
# sessions are useless on staging and staging tokens are useless in production.
API_PORT=8081

# The hostname staging is served under (Cloudflare tunnel target).
DOMAIN=staging.uwflow.local

RUN_MODE=staging

HASURA_GRAPHQL_ADMIN_SECRET=CHANGE_ME
HASURA_GRAPHQL_UNAUTHORIZED_ROLE=anonymous
HASURA_GRAPHQL_JWT_KEY=CHANGE_ME
# Hasura's in-container port; nginx proxies to hasura:$HASURA_PORT.
HASURA_PORT=8080

SENTRY_DSN_UW=
SENTRY_DSN_API=
SENTRY_TRACES_SAMPLE_RATE=
SENTRY_ERROR_SAMPLE_RATE=

NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

POSTGRES_DB=flow
POSTGRES_HOST=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=5432
POSTGRES_USER=postgres

POSTGRES_DUMP_PATH=

# Leave empty: the importer does not run on staging.
UW_API_KEY_V3=

# Deliberately unusable: staging holds real users' addresses.
SMTP_SERVER=localhost
SMTP_PORT=1
SMTP_FROM=staging@uwflow.invalid
SMTP_USERNAME=
SMTP_PASSWORD=

# Set per deploy by uwflow-staging; this value is ignored.
UWFLOW_IMAGE_TAG=unused
