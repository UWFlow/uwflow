#!/usr/bin/env python3
"""Post-deploy checks for staging. Run by `uwflow-staging smoke`, as root.

Each check exercises one layer a user request passes through, so a failure
names the broken layer instead of just "the site is down":

  containers -> right images -> Hasura metadata -> GraphQL via nginx
  -> Go API via nginx -> frontend bundle via nginx

Exits non-zero if any check fails. Standard library only.
"""

import json
import os
import re
import ssl
import subprocess
import sys
import time
import urllib.request

SHA = os.environ["STAGING_SHA"]
DOMAIN = os.environ["STAGING_DOMAIN"]
SITE = f"https://127.0.0.1:{os.environ['STAGING_HTTPS_PORT']}"
HASURA = f"http://127.0.0.1:{os.environ['STAGING_HASURA_PORT']}"
ADMIN_SECRET = os.environ["HASURA_ADMIN_SECRET"]

# Built from this commit and expected to be running.
BUILT_HERE = ["api", "frontend"]
EXPECTED_RUNNING = ["postgres", "hasura", *BUILT_HERE]

# Staging uses a self-signed certificate behind the Cloudflare tunnel.
INSECURE = ssl.create_default_context()
INSECURE.check_hostname = False
INSECURE.verify_mode = ssl.CERT_NONE

failures = []


def check(name):
    def wrap(fn):
        try:
            detail = fn()
        except Exception as error:  # noqa: BLE001 - report every failure
            failures.append(name)
            print(f"FAIL  {name}: {error}")
        else:
            print(f"PASS  {name}" + (f" ({detail})" if detail else ""))
        return fn

    return wrap


def request(url, *, body=None, headers=None, timeout=20):
    headers = {"Host": DOMAIN, **(headers or {})}
    data = None
    if body is not None:
        data = json.dumps(body).encode()
        headers["Content-Type"] = "application/json"
    req = urllib.request.Request(url, data=data, headers=headers)
    with urllib.request.urlopen(req, timeout=timeout, context=INSECURE) as resp:
        return resp.status, resp.headers.get("Content-Type", ""), resp.read()


def inspect(container, template):
    return subprocess.run(
        ["docker", "inspect", "-f", template, container],
        check=True, capture_output=True, text=True,
    ).stdout.strip()


@check("containers are running and not restarting")
def _():
    before = {}
    for name in EXPECTED_RUNNING:
        state = inspect(name, "{{.State.Status}} {{.RestartCount}}").split()
        if state[0] != "running":
            raise AssertionError(f"{name} is {state[0]}")
        before[name] = state[1]
    time.sleep(10)  # A crash-looping container restarts within this window.
    for name in EXPECTED_RUNNING:
        if inspect(name, "{{.RestartCount}}") != before[name]:
            raise AssertionError(f"{name} restarted during the check")
    return ", ".join(EXPECTED_RUNNING)


@check(f"api and frontend run images built from {SHA[:12]}")
def _():
    for name in BUILT_HERE:
        revision = inspect(name, '{{index .Config.Labels "org.opencontainers.image.revision"}}')
        if revision != SHA:
            raise AssertionError(f"{name} runs revision {revision or '(unlabelled)'}")


@check("Hasura metadata is consistent with the database")
def _():
    req = urllib.request.Request(
        f"{HASURA}/v1/metadata",
        data=json.dumps({"type": "get_inconsistent_metadata", "args": {}}).encode(),
        headers={"Content-Type": "application/json", "X-Hasura-Admin-Secret": ADMIN_SECRET},
    )
    with urllib.request.urlopen(req, timeout=20) as resp:
        result = json.load(resp)
    if not result.get("is_consistent"):
        names = [o.get("name") or o.get("definition") for o in result.get("inconsistent_objects", [])]
        raise AssertionError(f"inconsistent objects: {names[:5]}")


@check("anonymous GraphQL query through nginx returns courses")
def _():
    status, _, body = request(f"{SITE}/graphql", body={"query": "{ course(limit: 1) { code name } }"})
    result = json.loads(body)
    if status != 200 or "errors" in result:
        raise AssertionError(result.get("errors", status))
    courses = result["data"]["course"]
    if not courses:
        raise AssertionError("course table is empty; was the production dump restored?")
    return courses[0]["code"]


@check("Go API serves search data through nginx")
def _():
    status, _, body = request(f"{SITE}/api/data/search", timeout=60)
    result = json.loads(body)
    if status != 200 or not result.get("courses"):
        raise AssertionError(f"status {status}, keys {sorted(result)[:5]}")
    return f"{len(result['courses'])} courses"


@check("frontend serves index.html and its JavaScript bundle")
def _():
    status, _, body = request(f"{SITE}/")
    html = body.decode()
    if status != 200 or 'id="root"' not in html:
        raise AssertionError(f"status {status}, no React root in index.html")
    scripts = re.findall(r'src="(/static/js/[^"]+\.js)"', html)
    if not scripts:
        raise AssertionError("index.html references no /static/js bundle")
    status, content_type, _ = request(f"{SITE}{scripts[0]}")
    if status != 200 or "javascript" not in content_type:
        raise AssertionError(f"{scripts[0]} returned {status} {content_type}")
    return scripts[0]


if failures:
    print(f"\n{len(failures)} smoke check(s) failed: {', '.join(failures)}")
    sys.exit(1)
print("\nAll smoke checks passed")
